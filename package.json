{
  "name": "neverdue",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "app",
    "backend",
    "infra"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p scripts --noEmit",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w app",
    "synth": "npm run synth -w infra",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run synth"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1176.0",
    "@aws-sdk/client-dynamodb": "^3.1176.0",
    "@aws-sdk/client-ssm": "^3.1176.0",
    "@aws-sdk/lib-dynamodb": "^3.1176.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.6.6",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "web-push": "^4.0.0"
  }
}
